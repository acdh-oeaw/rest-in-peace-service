{
	"name": "@acdh-oeaw/rest-in-peace",
	"private": true,
	"license": "MIT",
	"type": "module",
	"engines": {
		"node": "^26"
	},
	"packageManager": "pnpm@12.21.0",
	"scripts": {
		"build": "astro build",
		"dev": "astro dev",
		"format:check": "oxfmt --check",
		"format:fix": "oxfmt",
		"lint:check": "run-p --continue-on-error \"lint:*:check\"",
		"lint:fix": "run-p --continue-on-error \"lint:*:fix\"",
		"lint:code:check": "eslint . --cache",
		"lint:code:fix": "pnpm run lint:code:check --fix",
		"lint:styles:check": "stylelint \"./**/*.@(astro|css)\" --cache --ignore-path ./.gitignore",
		"lint:styles:fix": "pnpm run lint:styles:check --fix",
		"preinstall": "npx only-allow pnpm",
		"prepare": "run-s setup",
		"setup": "is-in-ci || simple-git-hooks",
		"start": "astro preview",
		"sync": "astro sync",
		"test": "exit 0",
		"test:e2e": "playwright test",
		"test:e2e:codegen": "playwright codegen",
		"test:e2e:install": "playwright install --with-deps",
		"test:e2e:ui": "playwright test --ui",
		"test:e2e:update-snapshots": "playwright test --update-snapshots",
		"test:e2e:update-snapshots:docker": "bash scripts/update-snapshots-docker.sh",
		"types:check": "astro check",
		"validate": "run-p format:check lint:check types:check test test:e2e"
	},
	"dependencies": {
		"@acdh-oeaw/keystatic-lib": "^0.4.1",
		"@acdh-oeaw/lib": "^0.1.12",
		"@acdh-oeaw/mdx-lib": "^0.2.0",
		"@acdh-oeaw/validate-env": "^0.0.3",
		"@astrojs/mdx": "^8.1.6",
		"@astrojs/node": "^11.1.14",
		"@astrojs/react": "^7.1.9",
		"@astrojs/rss": "^4.0.19",
		"@astrojs/sitemap": "^3.7.6",
		"@fontsource-variable/inter": "^5.3.0",
		"@iconify-json/lucide": "^1.2.157",
		"@keystatic/astro": "^6.0.0",
		"@keystatic/core": "^0.6.10",
		"astro": "^7.4.13",
		"astro-icon": "^1.2.0",
		"date-fns": "^4.4.0",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"rehype-slug": "^6.0.0",
		"remark-frontmatter": "^5.0.0",
		"remark-gfm": "^4.0.1",
		"remark-mdx-frontmatter": "^6.0.0",
		"remark-smartypants": "^3.0.3",
		"sharp": "^0.35.5",
		"valibot": "^1.5.0",
		"vite": "^8.3.8"
	},
	"devDependencies": {
		"@acdh-oeaw/eslint-config": "^2.0.13",
		"@acdh-oeaw/eslint-config-astro": "^2.0.17",
		"@acdh-oeaw/eslint-config-playwright": "^2.0.15",
		"@acdh-oeaw/eslint-config-react": "^2.0.14",
		"@acdh-oeaw/stylelint-config": "^2.3.2",
		"@acdh-oeaw/tsconfig": "^1.5.1",
		"@astrojs/check": "^0.9.12",
		"@astrojs/compiler-rs": "^0.5.3",
		"@astrojs/ts-plugin": "^1.11.0",
		"@playwright/test": "^1.65.1",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.5",
		"@types/hast": "^3.0.5",
		"@types/mdx": "^2.0.14",
		"@types/node": "^26",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"axe-core": "^4.14.1",
		"axe-playwright": "^2.2.2",
		"eslint": "^9.39.5",
		"eslint-config-flat-gitignore": "^0.3.0",
		"is-in-ci": "^2.0.0",
		"lint-staged": "^15.5.2",
		"npm-run-all2": "^7.0.2",
		"oxfmt": "^0.79.0",
		"schema-dts": "^1.1.5",
		"simple-git-hooks": "^2.14.0",
		"stylelint": "^16.26.1",
		"tailwindcss": "^4.3.5",
		"type-fest": "^4.41.0",
		"typescript": "^5.9.3"
	},
	"browserslist": {
		"development": [
			"last 1 chrome version",
			"last 1 firefox version",
			"last 1 safari version"
		],
		"production": [
			">=0.75%",
			"not dead",
			"not op_mini all"
		]
	},
	"lint-staged": {
		"*.astro": [
			"eslint --cache --fix",
			"stylelint --cache --fix",
			"oxfmt --no-error-on-unmatched-pattern"
		],
		"*.css": [
			"stylelint --cache --fix",
			"oxfmt --no-error-on-unmatched-pattern"
		],
		"*.@(js|ts|tsx)": [
			"eslint --cache --fix",
			"oxfmt --no-error-on-unmatched-pattern"
		],
		"*.!(astro|css|js|ts|tsx)": "oxfmt --no-error-on-unmatched-pattern"
	},
	"simple-git-hooks": {
		"pre-commit": "pnpm exec lint-staged"
	},
	"stylelint": {
		"extends": "@acdh-oeaw/stylelint-config"
	}
}
