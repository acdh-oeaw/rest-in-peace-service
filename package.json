{
	"name": "@acdh-oeaw/rest-in-peace",
	"private": true,
	"license": "MIT",
	"type": "module",
	"engines": {
		"node": "^26"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "12.21.0",
			"onFail": "error"
		}
	},
	"scripts": {
		"build": "astro build",
		"dev": "astro dev",
		"format:check": "oxfmt --check",
		"format:fix": "oxfmt",
		"lint:check": "oxlint",
		"lint:fix": "oxlint --fix",
		"prepare": "pnpm run setup",
		"setup": "node ./scripts/setup.js",
		"start": "astro preview",
		"styles:check": "stylelint \"./**/*.@(astro|css)\" --cache --ignore-path ./.gitignore",
		"styles:fix": "stylelint \"./**/*.@(astro|css)\" --cache --fix --ignore-path ./.gitignore",
		"sync": "astro sync",
		"test": "exit 0",
		"test:e2e": "playwright test",
		"test:e2e:update-snapshots:docker": "bash scripts/update-snapshots-docker.sh",
		"types:check": "astro check"
	},
	"dependencies": {
		"@acdh-oeaw/keystatic-lib": "^0.8.2",
		"@acdh-oeaw/lib": "^0.1.12",
		"@acdh-oeaw/mdx-lib": "^0.2.0",
		"@acdh-oeaw/validate-env": "^0.4.0",
		"@astrojs/mdx": "^8.1.6",
		"@astrojs/node": "^11.1.14",
		"@astrojs/react": "^7.1.9",
		"@astrojs/rss": "^4.0.19",
		"@astrojs/sitemap": "^3.7.6",
		"@fontsource-variable/inter": "^5.3.0",
		"@iconify-json/lucide": "^1.2.157",
		"@keystatic/astro": "^6.0.0",
		"@keystatic/core": "^0.6.10",
		"astro": "^7.4.13",
		"astro-icon": "^1.2.0",
		"date-fns": "^4.4.0",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"rehype-slug": "^6.0.0",
		"remark-frontmatter": "^5.0.0",
		"remark-gfm": "^4.0.1",
		"remark-mdx-frontmatter": "^6.0.0",
		"remark-smartypants": "^3.0.3",
		"sharp": "^0.35.5",
		"valibot": "^1.5.0",
		"vite": "^8.3.8"
	},
	"devDependencies": {
		"@acdh-oeaw/stylelint-config": "^4.0.0",
		"@acdh-oeaw/tsconfig": "^1.5.1",
		"@astrojs/check": "^0.9.12",
		"@astrojs/compiler-rs": "^0.5.3",
		"@astrojs/ts-plugin": "^1.11.0",
		"@playwright/test": "^1.65.1",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.5",
		"@types/hast": "^3.0.5",
		"@types/mdx": "^2.0.14",
		"@types/node": "^26",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"axe-core": "^4.14.1",
		"axe-playwright": "^2.2.2",
		"eslint-plugin-playwright": "^2.12.2",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-regexp": "^3.3.3",
		"eslint-plugin-simple-import-sort": "^14.0.0",
		"is-in-ci": "^2.0.0",
		"lefthook": "^2.2.2",
		"oxfmt": "^0.79.0",
		"oxlint": "^1.94.0",
		"oxlint-tsgolint": "^7.0.2007",
		"schema-dts": "^2.1.0",
		"stylelint": "^18.1.0",
		"tailwindcss": "^4.3.5",
		"type-fest": "^6.0.3",
		"typescript": "^6.0.3"
	},
	"browserslist": {
		"development": [
			"last 1 chrome version",
			"last 1 firefox version",
			"last 1 safari version"
		],
		"production": [
			">=0.75%",
			"not dead",
			"not op_mini all"
		]
	},
	"stylelint": {
		"extends": "@acdh-oeaw/stylelint-config"
	}
}
