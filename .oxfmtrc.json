{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"endOfLine": "lf",
	"printWidth": 100,
	"proseWrap": "always",
	"semi": true,
	"singleQuote": false,
	"tabWidth": 2,
	"trailingComma": "all",
	"useTabs": true,
	"sortPackageJson": false,
	"sortImports": {
		"groups": [
			["side_effect", "side_effect_style"],
			"builtin",
			"external",
			["internal", "subpath"],
			["parent", "sibling", "index"],
			"style",
			"unknown"
		]
	},
	"astro": true,
	"ignorePatterns": ["content/**", "public/**", "pnpm-lock.yaml"]
}
